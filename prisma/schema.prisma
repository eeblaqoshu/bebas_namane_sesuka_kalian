// prisma/schema.prisma
// Sistem Presensi Pengurus Organisasi
// Sumber kebenaran kebutuhan: PRD.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUM (Native MySQL ENUM)
// ─────────────────────────────────────────────

enum StatusPeriode {
  aktif
  selesai
}

enum RoleAdsek {
  admin
  sekretaris_umum
  sekretaris_inti
}

enum PeranPanitia {
  ketua
  sekretaris
  bendahara
  pj_divisi
  anggota
}

enum JenisAgenda {
  rapat_pj
  rapat_besar
  rapat_koordinasi
  hari_h
}

enum TargetPeserta {
  hanya_pj_pi
  semua_panitia
  semua_panitia_sto
}

enum StatusPresensi {
  hadir
  terlambat
}

// ─────────────────────────────────────────────
// 1. PERIODE
// ─────────────────────────────────────────────

model Periode {
  id         Int           @id @default(autoincrement())
  nama       String        @db.VarChar(255)
  tglMulai   DateTime      @map("tgl_mulai") @db.Date
  tglSelesai DateTime      @map("tgl_selesai") @db.Date
  status     StatusPeriode @default(aktif)

  sto    Sto[]
  proker Proker[]

  @@map("periode")
}

// ─────────────────────────────────────────────
// 2. AKUN & STO
// ─────────────────────────────────────────────

model AkunAdsek {
  id          Int       @id @default(autoincrement())
  nama        String    @db.VarChar(255)
  email       String    @unique @db.VarChar(191)
  firebaseUid String?   @unique @map("firebase_uid") @db.VarChar(191)
  role        RoleAdsek

  prokerDibuat Proker[]
  agendaDibuat Agenda[]
  sesiDibuat   SesiPresensi[]

  @@map("akun_adsek")
}

model Sto {
  id          Int     @id @default(autoincrement())
  periodeId   Int     @map("periode_id")
  nama        String  @db.VarChar(255)
  nim         String  @db.VarChar(50)
  emailGoogle String  @unique @map("email_google") @db.VarChar(191)
  firebaseUid String? @unique @map("firebase_uid") @db.VarChar(191)
  jabatan     String? @db.VarChar(100)
  divisi      String? @db.VarChar(100)
  foto        String? @db.Text

  periode     Periode       @relation(fields: [periodeId], references: [id])
  kepanitiaan Kepanitiaan[]
  presensi    Presensi[]

  @@index([periodeId])
  @@map("STO")
}

// ─────────────────────────────────────────────
// 3. PROKER & KEPANITIAAN
// ─────────────────────────────────────────────

model Proker {
  id         Int      @id @default(autoincrement())
  periodeId  Int      @map("periode_id")
  nama       String   @db.VarChar(255)
  deskripsi  String?  @db.Text
  dibuatOleh Int      @map("dibuat_oleh")
  createdAt  DateTime @default(now()) @map("created_at")

  periode     Periode       @relation(fields: [periodeId], references: [id])
  pembuat     AkunAdsek     @relation(fields: [dibuatOleh], references: [id])
  kepanitiaan Kepanitiaan[]
  agenda      Agenda[]

  @@index([periodeId])
  @@map("proker")
}

model Kepanitiaan {
  id            Int          @id @default(autoincrement())
  prokerId      Int          @map("proker_id")
  stoId         Int          @map("sto_id")
  peran         PeranPanitia
  divisiPanitia String?      @map("divisi_panitia") @db.VarChar(100)

  proker Proker @relation(fields: [prokerId], references: [id], onDelete: Cascade)
  sto    Sto    @relation(fields: [stoId], references: [id])

  @@unique([prokerId, stoId])
  @@index([stoId])
  @@map("kepanitiaan")
}

// ─────────────────────────────────────────────
// 4. AGENDA (rapat PJ, rapat besar, rapat koordinasi, hari H)
// ─────────────────────────────────────────────

model Agenda {
  id               Int           @id @default(autoincrement())
  prokerId         Int           @map("proker_id")
  jenis            JenisAgenda
  judul            String        @db.VarChar(255)
  urutan           Int           @default(1)
  tglPelaksanaan   DateTime      @map("tgl_pelaksanaan") @db.Date
  waktuPelaksanaan DateTime      @map("waktu_pelaksanaan") @db.Time(0)
  lokasiNama       String?       @map("lokasi_nama") @db.VarChar(255)
  targetPeserta    TargetPeserta @map("target_peserta")
  dibuatOleh       Int           @map("dibuat_oleh")
  createdAt        DateTime      @default(now()) @map("created_at")

  proker  Proker         @relation(fields: [prokerId], references: [id])
  pembuat AkunAdsek      @relation(fields: [dibuatOleh], references: [id])
  sesi    SesiPresensi[]

  @@index([prokerId, tglPelaksanaan])
  @@map("agenda")
}

// ─────────────────────────────────────────────
// 5. PRESENSI
// ─────────────────────────────────────────────

model SesiPresensi {
  id          Int      @id @default(autoincrement())
  agendaId    Int      @map("agenda_id")
  dibuatOleh  Int      @map("dibuat_oleh")
  bukaAt      DateTime @map("buka_at")
  tutupAt     DateTime @map("tutup_at")
  durasiMenit Int      @map("durasi_menit")
  lat         Decimal  @db.Decimal(9, 6)
  lng         Decimal  @db.Decimal(9, 6)
  radiusM     Int      @default(500) @map("radius_m")
  qrSecret    String   @map("qr_secret") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  agenda   Agenda     @relation(fields: [agendaId], references: [id])
  pembuat  AkunAdsek  @relation(fields: [dibuatOleh], references: [id])
  presensi Presensi[]

  @@index([agendaId])
  @@map("sesi_presensi")
}

model Presensi {
  id        Int            @id @default(autoincrement())
  sesiId    Int            @map("sesi_id")
  stoId     Int            @map("sto_id")
  waktuScan DateTime       @map("waktu_scan")
  lat       Decimal        @db.Decimal(9, 6)
  lng       Decimal        @db.Decimal(9, 6)
  jarakM    Int            @map("jarak_m")
  status    StatusPresensi

  sesi SesiPresensi @relation(fields: [sesiId], references: [id])
  sto  Sto          @relation(fields: [stoId], references: [id])

  @@unique([sesiId, stoId])
  @@index([stoId])
  @@map("presensi")
}
